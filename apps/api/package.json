{
  "name": "@openseat/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && cp -r src/db/migrations dist/db/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "test": "node --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@openseat/shared": "1.0.0",
    "fastify": "^5.12.5",
    "ioredis": "^5.8.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
