# API (apps/api). Every setting is optional for local development.

# Postgres. Without it the API keeps data in memory.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/openseat
# Redis. Without it locks, rate limits and request merging work for one process only.
REDIS_URL=redis://127.0.0.1:6379

# Exact browser origins allowed to call the API, comma separated. Never use '*'.
ALLOWED_ORIGINS=http://localhost:5173
# Set to true when running behind a proxy or load balancer, so rate limits see the real client IP.
TRUST_PROXY=false

PORT=8787
PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8787

# Data source per carrier: mock (sample data) or none. See docs/data-sources.md.
ADAPTER=mock
# ADAPTER_EK=mock
# ADAPTER_EY=mock
# ADAPTER_QR=mock

# Days per fetch block, and when a day counts as stale for searches.
CHUNK_DAYS=15
STALE_AFTER_MIN=360

# Refresh scheduler. Set SCHEDULER=off to disable.
SCHEDULER=on
TRUNK_ROUTES=EK:DXB:LHR,EK:RUH:LHR,QR:DOH:LHR,EY:AUH:LHR
TRUNK_MAX_AGE_MIN=180
ALERT_MAX_AGE_MIN=90

# Alert email. Without SMTP_URL alerts are written to the log.
# SMTP_URL=smtps://user:pass@smtp.example.com
# MAIL_FROM=openseat <alerts@example.com>

# Web (apps/web), read at build time.
# Leave VITE_API_URL empty to run the site on built-in sample data with no API.
VITE_API_URL=
VITE_SAMPLE_DATA=true
