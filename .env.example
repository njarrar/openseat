# API (apps/api). Every setting is optional for local development.

# Postgres. Without it the API keeps data in memory.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/openseat
# Redis. Without it locks, rate limits and request merging work for one process only.
REDIS_URL=redis://127.0.0.1:6379

# Exact browser origins allowed to call the API, comma separated. Never use '*'.
ALLOWED_ORIGINS=http://localhost:5173
# Set to true when running behind a proxy or load balancer, so rate limits see the real client IP.
TRUST_PROXY=false

PORT=8787
PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8787

# Data source per carrier: mock (sample data), seatsaero or none. See docs/data-sources.md.
ADAPTER=mock
# ADAPTER_EK=seatsaero
# ADAPTER_EY=seatsaero
# ADAPTER_QR=mock

# seats.aero partner API. A Pro key is for personal use; a public site needs their written approval.
# SEATS_AERO_API_KEY=
# Source name per program. Emirates and Etihad are set by default; set QR only once seats.aero lists Qatar.
# SEATS_AERO_SOURCE_EK=emirates
# SEATS_AERO_SOURCE_EY=etihad
# SEATS_AERO_SOURCE_QR=

# Days per fetch block, and when a day counts as stale for searches.
CHUNK_DAYS=15
STALE_AFTER_MIN=360

# Refresh scheduler. Set SCHEDULER=off to disable.
SCHEDULER=on
TRUNK_ROUTES=EK:DXB:LHR,EK:RUH:LHR,QR:DOH:LHR,EY:AUH:LHR
TRUNK_MAX_AGE_MIN=180
ALERT_MAX_AGE_MIN=90

# Alert email. Without SMTP_URL alerts are written to the log.
# SMTP_URL=smtps://user:pass@smtp.example.com
# MAIL_FROM=openseat <alerts@example.com>

# Telegram alerts. Make a bot with @BotFather, then point its webhook at
# {API_PUBLIC_URL}/api/v1/telegram/webhook with this secret (see docs/alerts.md).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_NAME=openseat_bot
# TELEGRAM_WEBHOOK_SECRET=

# WhatsApp alerts through the WhatsApp Cloud API, with an approved template (see docs/alerts.md).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=seat_alert
# WHATSAPP_TEMPLATE_LANG=en

# Cloudflare Turnstile bot check on alerts and refresh. Both keys come from the Cloudflare dashboard.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Web (apps/web), read at build time.
# Leave VITE_API_URL empty to run the site on built-in sample data with no API.
VITE_API_URL=
VITE_SAMPLE_DATA=true
